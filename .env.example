# ========================================================
# MindMesh Verify - Environment Configuration Template
# Copy this file to .env and replace placeholders with real keys.
# DO NOT commit .env containing real API keys to version control.
# ========================================================

# Application Settings
APP_ENV=development
APP_DEBUG=true
LOG_LEVEL=INFO

# Storage Paths
DATABASE_PATH=data/mindmesh.db
OUTPUT_DIR=outputs

# Phase 2 Search & AI Verification APIs
TAVILY_API_KEY=your_tavily_api_key
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-3.5-flash-lite
